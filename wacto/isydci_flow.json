                  },
                  {
                    "id": "Gujarat",
                    "title": "Gujarat"
                  },
                  {
                    "id": "Haryana",
                    "title": "Haryana"
                  },
                  {
                    "id": "Himachal Pradesh",
                    "title": "Himachal Pradesh"
                  },
                  {
                    "id": "Jammu and Kashmir",
                    "title": "Jammu & Kashmir"
                  },
                  {
                    "id": "Jharkhand",
                    "title": "Jharkhand"
                  },
                  {
                    "id": "Karnataka",
                    "title": "Karnataka"
                  },
                  {
                    "id": "Kerala",
                    "title": "Kerala"
                  },
                  {
                    "id": "Ladakh",
                    "title": "Ladakh"
                  },
                  {
                    "id": "Madhya Pradesh",
                    "title": "Madhya Pradesh"
                  },
                  {
                    "id": "Maharashtra",
                    "title": "Maharashtra"
                  },
                  {
                    "id": "Manipur",
                    "title": "Manipur"
                  },
                  {
                    "id": "Meghalaya",
                    "title": "Meghalaya"
                  },
                  {
                    "id": "Mizoram",
                    "title": "Mizoram"
                  },
                  {
                    "id": "Nagaland",
                    "title": "Nagaland"
                  },
                  {
                    "id": "Odisha",
                    "title": "Odisha"
                  },
                  {
                    "id": "Puducherry",
                    "title": "Puducherry"
                  },
                  {
                    "id": "Punjab",
                    "title": "Punjab"
                  },
                  {
                    "id": "Rajasthan",
                    "title": "Rajasthan"
                  },
                  {
                    "id": "Sikkim",
                    "title": "Sikkim"
                  },
                  {
                    "id": "Tamil Nadu",
                    "title": "Tamil Nadu"
                  },
                  {
                    "id": "Telangana",
                    "title": "Telangana"
                  },
                  {
                    "id": "Tripura",
                    "title": "Tripura"
                  },
                  {
                    "id": "Uttar Pradesh",
                    "title": "Uttar Pradesh"
                  },
                  {
                    "id": "Uttarakhand",
                    "title": "Uttarakhand"
                  },
                  {
                    "id": "West Bengal",
                    "title": "West Bengal"
                  }
                ]
              },
              {
                "type": "TextInput",
                "name": "district",
                "label": "District *",
                "required": true,
                "helper-text": "e.g. Chennai"
              },
              {
                "type": "TextInput",
                "name": "assembly",
                "label": "Assembly / Constituency *",
                "required": true,
                "helper-text": "e.g. Velachery"
              },
              {
                "type": "TextInput",
                "name": "zone",
                "label": "Zone / Ward / Area *",
                "required": true,
                "helper-text": "e.g. Ward 25"
              },
              {
                "type": "TextInput",
                "name": "dob",
                "label": "Date of Birth *",
                "required": true,
                "helper-text": "e.g. 15 Aug 1999 (Age is auto-calculated)"
              },
              {
                "type": "TextInput",
                "name": "age",
                "label": "Age",
                "required": false,
                "helper-text": "e.g. 27 Years"
              },
              {
                "type": "Dropdown",
                "name": "blood_group",
                "label": "Blood Group *",
                "required": true,
                "data-source": [
                  {
                    "id": "O+",
                    "title": "O+"
                  },
                  {
                    "id": "A+",
                    "title": "A+"
                  },
                  {
                    "id": "B+",
                    "title": "B+"
                  },
                  {
                    "id": "AB+",
                    "title": "AB+"
                  },
                  {
                    "id": "O-",
                    "title": "O-"
                  },
                  {
                    "id": "A-",
                    "title": "A-"
                  },
                  {
                    "id": "B-",
                    "title": "B-"
                  },
                  {
                    "id": "AB-",
                    "title": "AB-"
                  }
                ]
              },
              {
                "type": "TextInput",
                "name": "address",
                "label": "Full Address *",
                "required": true,
                "helper-text": "No. 12, 3rd Street, Velachery, Chennai"
              },
              {
                "type": "RadioButtonsGroup",
                "name": "photo_option",
                "label": "Upload Your Photo",
                "required": true,
                "data-source": [
                  {
                    "id": "passport_photo",
                    "title": "Passport Photo (300 DPI | JPG/PNG)",
                    "description": "Clear passport photo for verified ID card"
                  }
                ]
              },
              {
                "type": "RadioButtonsGroup",
                "name": "confirmation",
                "label": "Declaration",
                "required": true,
                "data-source": [
                  {
                    "id": "confirmed",
                    "title": "✓ Please confirm that all the details are correct."
                  }
                ]
              },
              {
                "type": "Footer",
                "label": "Submit Registration",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "screen": "ATHLETE_REGISTRATION",
                    "full_name": "${form.full_name}",
                    "contact_number": "${form.contact_number}",
                    "state": "${form.state}",
                    "district": "${form.district}",
                    "assembly": "${form.assembly}",
                    "zone": "${form.zone}",
                    "dob": "${form.dob}",
                    "age": "${form.age}",
                    "blood_group": "${form.blood_group}",
                    "address": "${form.address}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "WELCOME",
      "title": "ISYDCI Welcome & Menu",
      "terminal": false,
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "ISYDCI National Council"
          },
          {
            "type": "TextSubheading",
            "text": "🏆 Welcome to ISYDCI Sports Portal"
          },
          {
            "type": "TextBody",
            "text": "Official National Sports Council accreditation & athlete membership portal.\n\n📍 Ministry Reg No: 49/1997 | New Delhi HQ\n\nPlease select an option below to proceed:"
          },
          {
            "type": "Form",
            "name": "welcome_form",
            "children": [
              {
                "type": "RadioButtonsGroup",
                "name": "menu_choice",
                "label": "Choose Option",
                "required": true,
                "data-source": [
                  {
                    "id": "register",
                    "title": "Register Athlete (New Registration)",
                    "description": "New membership & digital ID card issuance"
                  },
                  {
                    "id": "card",
                    "title": "My Membership Card (Registered Athlete)",
                    "description": "View & download verified ID card"
                  },
                  {
                    "id": "about",
                    "title": "About ISYDCI",
                    "description": "Council accreditation & ministry recognition"
                  },
                  {
                    "id": "support",
                    "title": "Contact Support",
                    "description": "Helpline: +91 99946 27551 & office desk"
                  }
                ]
              },
              {
                "type": "Footer",
                "label": "Choose Option",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "screen": "WELCOME",
                    "menu_choice": "${form.menu_choice}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "REG_SUCCESS",
      "title": "Registration Completed",
      "terminal": true,
      "data": {
        "name": {
          "type": "string",
          "__example__": "AMIT KUMAR"
        },
        "member_id": {
          "type": "string",
          "__example__": "ISYDCI-684DDC04"
        },
        "sport": {
          "type": "string",
          "__example__": "ATHLETICS"
        },
        "state": {
          "type": "string",
          "__example__": "TAMIL NADU"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "🎉 Application Submitted!"
          },
          {
            "type": "TextSubheading",
            "text": "Welcome to ISYDCI National Sports Community"
          },
          {
            "type": "TextBody",
            "text": "Thank you, ${data.name}!\n\nYour athlete registration has been registered with ISYDCI National Database (Reg No: 49/1997).\n\n🆔 Member ID: ${data.member_id}\n🥊 Primary Sport: ${data.sport}\n📍 Affiliated State: ${data.state}\n\n✅ Council Secretariat will verify and issue your Official Digital ID Card.\n✅ You will receive championship draws & event updates on WhatsApp.\n\nHelpline: +91 99946 27551\nOfficial Portal: https://isydci.vercel.app/"
          },
          {
            "type": "Footer",
            "label": "Done",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "status": "SUBMITTED",
                "member_id": "${data.member_id}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "MY_CARD",
      "title": "My Membership Card",
      "terminal": false,
      "data": {
        "member_id": {
          "type": "string",
          "__example__": ""
        },
        "name": {
          "type": "string",
          "__example__": ""
        },
        "sport": {
          "type": "string",
          "__example__": ""
        },
        "state": {
          "type": "string",
          "__example__": ""
        },
        "district": {
          "type": "string",
          "__example__": ""
        },
        "status": {
          "type": "string",
          "__example__": ""
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "🪪 Official ISYDCI Membership Card"
          },
          {
            "type": "TextSubheading",
            "text": "Athlete ID Verification & Card Delivery"
          },
          {
            "type": "TextBody",
            "text": "Indian Sports Youth Development Council of India\nMinistry Reg No: 49/1997 | New Delhi HQ\n\nEnter your Member ID or registered phone number to view and download your official Front & Back Digital ID card."
          },
          {
            "type": "Form",
            "name": "lookup_form",
            "children": [
              {
                "type": "TextInput",
                "name": "lookup_id",
                "label": "Member ID or 10-Digit Mobile Number",
                "required": true
              },
              {
                "type": "Footer",
                "label": "Verify & View Card",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "screen": "MY_CARD",
                    "lookup_id": "${form.lookup_id}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "CARD_VIEW",
      "title": "Athlete ID Card",
      "terminal": true,
      "data": {
        "name": {
          "type": "string",
          "__example__": "AMIT KUMAR"
        },
        "member_id": {
          "type": "string",
          "__example__": "ISYDCI-684DDC04"
        },
        "sport": {
          "type": "string",
          "__example__": "ATHLETICS"
        },
        "state": {
          "type": "string",
          "__example__": "Tamil Nadu"
        },
        "district": {
          "type": "string",
          "__example__": "Chennai"
        },
        "status": {
          "type": "string",
          "__example__": "Verified Athlete ✅"
        },
        "dob": {
          "type": "string",
          "__example__": "15 Aug 1999"
        },
        "blood_group": {
          "type": "string",
          "__example__": "O+"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "🪪 Verified Athlete Card"
          },
          {
            "type": "TextSubheading",
            "text": "ISYDCI Council Accreditation"
          },
          {
            "type": "TextBody",
            "text": "👤 Athlete: ${data.name}\n🆔 Member ID: ${data.member_id}\n🥊 Sport: ${data.sport}\n📍 State: ${data.state} (${data.district})\n📅 DOB: ${data.dob}\n🩸 Blood Group: ${data.blood_group}\nStatus: ${data.status}\n\n📄 Official Front & Back digital ID card generated by Cloudinary is ready."
          },
          {
            "type": "Footer",
            "label": "Download ID Card",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "action": "DOWNLOAD_CARD",
                "member_id": "${data.member_id}",
                "name": "${data.name}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "ABOUT_ISYDCI",
      "title": "About ISYDCI",
      "terminal": true,
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "🏛️ ISYDCI National Sports Council"
          },
          {
            "type": "TextSubheading",
            "text": "Empowering Indian Athletes (Reg No: 49/1997)"
          },
          {
            "type": "TextBody",
            "text": "Indian Sports Youth Development Council of India (ISYDCI) is a national sports accreditation and championship organization.\n\n📍 Ministry Registration: 49/1997\n📍 Head Office: New Delhi, India\n📍 Core Initiatives:\n• National Championships & State Selection Trials\n• Athlete Accreditation & Official ID Cards\n• Coaching Camps & Talent Scouting\n• Athlete Welfare & Sports Insurance\n\nOfficial Portal: https://isydci.vercel.app/"
          },
          {
            "type": "Footer",
            "label": "Back to Chat",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "action": "VIEWED_ABOUT"
              }
            }
          }
        ]
      }
    },
    {
      "id": "CONTACT_SUPPORT",
      "title": "Contact Support",
      "terminal": true,
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "📞 ISYDCI Council Secretariat"
          },
          {
            "type": "TextSubheading",
            "text": "National Athlete Helpline"
          },
          {
            "type": "TextBody",
            "text": "For athlete verification, membership cards, tournament entries, or affiliation:\n\n📞 Helpline: +91 99946 27551\n📧 Email: support@isydci.org\n🌐 Portal: https://isydci.vercel.app/\n📍 Headquarters: ISYDCI Bhavan, New Delhi - 110001, India\n\nOffice Hours: Mon - Sat (9:30 AM - 6:00 PM IST)"
          },
          {
            "type": "Footer",
            "label": "Done",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "action": "CONTACT_SUPPORT_VIEWED"
              }
            }
          }
        ]
