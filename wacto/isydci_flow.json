{
  "version": "6.0",
  "data_api_version": "3.0",
  "routing_model": {
    "ATHLETE_REGISTRATION": [
      "REG_SUCCESS"
    ],
    "REG_SUCCESS": [],
    "WELCOME": [
      "ATHLETE_REGISTRATION",
      "MY_CARD",
      "ABOUT_ISYDCI",
      "CONTACT_SUPPORT"
    ],
    "MY_CARD": [
      "CARD_VIEW"
    ],
    "CARD_VIEW": [],
    "ABOUT_ISYDCI": [],
    "CONTACT_SUPPORT": []
  },
  "screens": [
    {
      "id": "ATHLETE_REGISTRATION",
      "title": "Athlete Registration",
      "terminal": false,
      "data": {
        "contact_number": {
          "type": "string",
          "__example__": "+91 91234 56789"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Athlete Registration"
          },
          {
            "type": "TextSubheading",
            "text": "Please enter your location details."
          },
          {
            "type": "TextBody",
            "text": "📍 Ministry Reg No: 49/1997 | New Delhi HQ\nComplete your official membership registration in 1 simple step."
          },
          {
            "type": "Form",
            "name": "athlete_reg_form",
            "children": [
              {
                "type": "TextInput",
                "name": "full_name",
                "label": "Full Name *",
                "required": true,
                "helper-text": "Official name as per Govt ID"
              },
              {
                "type": "TextInput",
                "name": "contact_number",
                "label": "Mobile Number",
                "input-type": "phone",
                "required": true,
                "helper-text": "Automatically detected from WhatsApp"
              },
              {
                "type": "Dropdown",
                "name": "state",
                "label": "State / Union Territory *",
                "required": true,
                "data-source": [
                  {
                    "id": "Andaman and Nicobar Islands",
                    "title": "Andaman & Nicobar"
                  },
                  {
                    "id": "Andhra Pradesh",
                    "title": "Andhra Pradesh"
                  },
                  {
